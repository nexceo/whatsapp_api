# =====================================================================
# Evolution API - PRODUCTION environment (standalone deployment)
# Used by: docker-compose.production.yml
#
# This is a fully independent stack. It shares NOTHING with any other
# stack on the host (no network, no database, no redis, no volumes).
#
# HOW TO USE:
#   cp .env.production.example .env.production
#   scripts/install.sh will auto-fill the __PLACEHOLDER__ secrets below
#   with securely generated random values on first run. Or fill them in
#   yourself and skip that step. Never commit the resulting .env.production
#   file (it's gitignored).
# =====================================================================

# -----------------------------------------------------------------
# Compose-only variables (consumed by docker-compose.production.yml)
# -----------------------------------------------------------------
POSTGRES_DB=evolution_api
POSTGRES_USER=evolution
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

REDIS_PASSWORD=__REDIS_PASSWORD__

# Host-side ports (bound to 127.0.0.1 only in docker-compose.production.yml)
SERVER_PORT=8080
MANAGER_PORT=8081

# -----------------------------------------------------------------
# Evolution API application configuration
# -----------------------------------------------------------------
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_URL=http://localhost:8080

SSL_CONF_PRIVKEY=
SSL_CONF_FULLCHAIN=

SENTRY_DSN=

TELEMETRY_ENABLED=true
TELEMETRY_URL=

PROMETHEUS_METRICS=false
METRICS_AUTH_REQUIRED=true
METRICS_USER=prometheus
METRICS_PASSWORD=change_me_if_prometheus_metrics_enabled
METRICS_ALLOWED_IPS=127.0.0.1

PROXY_HOST=
PROXY_PORT=
PROXY_PROTOCOL=
PROXY_USERNAME=
PROXY_PASSWORD=

API_AUDIO_CONVERTER=
API_AUDIO_CONVERTER_KEY=

# Instance is bound to 127.0.0.1 only (no public domain/HTTPS yet), so
# CORS_ORIGIN=* is safe here -- it does not widen external exposure.
# Evolution API's CORS middleware rejects same-origin/no-Origin requests
# (curl, health checks, server-to-server) when this is set to a fixed
# allowlist, so keep it at the official default until a real domain with
# a browser-facing frontend is configured.
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

LOG_LEVEL=ERROR,WARN,INFO,LOG
LOG_COLOR=true
LOG_BAILEYS=error

EVENT_EMITTER_MAX_LISTENERS=50

DEL_INSTANCE=false

# -----------------------------------------------------------------
# Database - dedicated Postgres container (evolution-postgres)
# Not reachable from outside the evolution-network Docker network.
# -----------------------------------------------------------------
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:__POSTGRES_PASSWORD__@evolution-postgres:5432/evolution_api?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution_nexceo_prod

DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true

# -----------------------------------------------------------------
# Message queues / events - all disabled for the infra-only phase.
# Webhooks intentionally left disabled until CRM integration is
# explicitly approved -- do not flip these on as part of a routine
# deploy/update.
# -----------------------------------------------------------------
RABBITMQ_ENABLED=false
RABBITMQ_URI=amqp://localhost
RABBITMQ_EXCHANGE_NAME=evolution
RABBITMQ_FRAME_MAX=8192
RABBITMQ_GLOBAL_ENABLED=false
RABBITMQ_PREFIX_KEY=evolution

SQS_ENABLED=false
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=
SQS_ACCOUNT_ID=
SQS_REGION=
SQS_GLOBAL_ENABLED=false

WEBSOCKET_ENABLED=false
WEBSOCKET_GLOBAL_EVENTS=false
WEBSOCKET_ALLOWED_HOSTS=127.0.0.1,::1,::ffff:127.0.0.1

PUSHER_ENABLED=false
PUSHER_GLOBAL_ENABLED=false

KAFKA_ENABLED=false
KAFKA_CLIENT_ID=evolution-api
KAFKA_BROKERS=localhost:9092
KAFKA_GLOBAL_ENABLED=false

WA_BUSINESS_TOKEN_WEBHOOK=evolution
WA_BUSINESS_URL=https://graph.facebook.com
WA_BUSINESS_VERSION=v20.0
WA_BUSINESS_LANGUAGE=en_US

# Webhooks disabled until CRM integration step is explicitly approved.
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_ERRORS=false
WEBHOOK_EVENTS_ERRORS_WEBHOOK=

WEBHOOK_REQUEST_TIMEOUT_MS=60000
WEBHOOK_RETRY_MAX_ATTEMPTS=10
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true
WEBHOOK_RETRY_MAX_DELAY_SECONDS=300
WEBHOOK_RETRY_JITTER_FACTOR=0.2
WEBHOOK_RETRY_NON_RETRYABLE_STATUS_CODES=400,401,403,404,422

CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome

QRCODE_LIMIT=30
QRCODE_COLOR='#175197'

TYPEBOT_ENABLED=false
TYPEBOT_API_VERSION=latest

CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false

# -----------------------------------------------------------------
# Cache - dedicated Redis container (evolution-redis), password
# protected, not reachable from outside evolution-network.
# -----------------------------------------------------------------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:__REDIS_PASSWORD__@evolution-redis:6379/6
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# -----------------------------------------------------------------
# Object storage - disabled; using local instance volume for now.
# -----------------------------------------------------------------
S3_ENABLED=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=evolution
S3_PORT=443
S3_ENDPOINT=s3.domain.com
S3_REGION=eu-west-3
S3_USE_SSL=true

# -----------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------
AUTHENTICATION_API_KEY=__AUTHENTICATION_API_KEY__
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
LANGUAGE=en
